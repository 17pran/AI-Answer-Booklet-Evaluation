cat >> .gitignore <<'EOF'

# Local database
data/*.db

# Generated OCR files
data/processed/

# Local textbook PDFs
data/textbooks/*.pdf

# macOS metadata
Icon?
EOF
# Environment and secrets
.env
.env.*
!.env.example
venv/
.venv/

# Python cache
__pycache__/
*.py[cod]

# macOS files
.DS_Store
Icon?

# Local databases
data/*.db
*.sqlite
*.sqlite3

# Generated OCR output
data/processed/

# Local textbook PDFs
data/textbooks/*.pdf
